{
  "name": "mvn-claims-risk-api",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "postCreateCommand": "pip install -r requirements.txt && python data/generate_data.py && python scripts/run_pipeline.py",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Risk Scoring API",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"]
    }
  },
  "postAttachCommand": "echo 'Run: uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload'"
}
